# Salin file ini menjadi .env lalu isi nilainya untuk menjalankan/mencoba secara lokal
# (vercel dev akan membaca .env secara otomatis).

# Connection string dari Neon (Dashboard project > Connect > pilih "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-pooler.xx-xxx-1.aws.neon.tech/neondb?sslmode=require

# String acak bebas, dipakai untuk menandatangani cookie sesi login.
# Ganti dengan string acak panjang, misalnya hasil dari: openssl rand -hex 32
AUTH_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
